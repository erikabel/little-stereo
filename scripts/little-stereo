#!/bin/bash

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
omarchy_path="${OMARCHY_PATH:-/usr/share/omarchy}"
script_path="$(readlink -f "$0")"
preferences_dir="$config_home/omarchy/audio"
preferences="$preferences_dir/swapped-output-devices"
balances="$preferences_dir/output-balances"
balance_levels="$preferences_dir/output-balance-levels"
names="$preferences_dir/output-names"
wireplumber_dir="$config_home/wireplumber/wireplumber.conf.d"
rule_file="$wireplumber_dir/90-channel-swap.conf"

current_sink() {
  pactl get-default-sink
}

valid_sink() {
  [[ $1 =~ ^[A-Za-z0-9_.:-]+$ ]]
}

is_saved() {
  [[ -f $preferences ]] && grep -Fxq -- "$1" "$preferences"
}

save_preference() {
  local sink="$1" enabled="$2" temporary
  mkdir -p "$preferences_dir"
  temporary="$(mktemp "$preferences_dir/.swapped-output-devices.XXXXXX")"
  if [[ -f $preferences ]]; then
    grep -Fvx -- "$sink" "$preferences" > "$temporary" || true
  fi
  [[ $enabled == true ]] && printf '%s\n' "$sink" >> "$temporary"
  mv "$temporary" "$preferences"
}

# Custom output names. Stored like the other per-output settings: one TSV row
# keyed by the sink name, so a renamed output keeps its name across reboots and
# reconnects. The label is written verbatim in UTF-8 -- emoji included -- and
# only tab and newline are forbidden, because they separate the records.
saved_name() {
  local sink="$1"
  [[ -f $names ]] || return 0
  awk -F '\t' -v sink="$sink" '$1 == sink {print $2; exit}' "$names"
}

save_name() {
  local sink="$1" label="$2" temporary
  mkdir -p "$preferences_dir"
  temporary="$(mktemp "$preferences_dir/.output-names.XXXXXX")"
  if [[ -f $names ]]; then
    awk -F '\t' -v sink="$sink" '$1 != sink' "$names" > "$temporary"
  fi
  # An empty label is how a rename is undone: drop the row and fall back to the
  # name the device reports for itself.
  [[ -n $label ]] && printf '%s\t%s\n' "$sink" "$label" >> "$temporary"
  mv "$temporary" "$names"
}

saved_balance() {
  local sink="$1"
  [[ -f $balances ]] && awk -F '\t' -v sink="$sink" '$1 == sink {print $2; found=1; exit} END {if (!found) print 0}' "$balances" || echo 0
}

save_balance() {
  local sink="$1" value="$2" temporary
  mkdir -p "$preferences_dir"
  temporary="$(mktemp "$preferences_dir/.output-balances.XXXXXX")"
  if [[ -f $balances ]]; then
    awk -F '\t' -v sink="$sink" '$1 != sink' "$balances" > "$temporary"
  fi
  printf '%s\t%s\n' "$sink" "$value" >> "$temporary"
  mv "$temporary" "$balances"
}

saved_level() {
  local sink="$1"
  if [[ -f $balance_levels ]]; then
    awk -F '\t' -v sink="$sink" '$1 == sink {print $2; exit}' "$balance_levels"
  fi
  return 0
}

save_level() {
  local sink="$1" value="$2" temporary
  mkdir -p "$preferences_dir"
  temporary="$(mktemp "$preferences_dir/.output-balance-levels.XXXXXX")"
  if [[ -f $balance_levels ]]; then
    awk -F '\t' -v sink="$sink" '$1 != sink' "$balance_levels" > "$temporary"
  fi
  printf '%s\t%s\n' "$sink" "$value" >> "$temporary"
  mv "$temporary" "$balance_levels"
}

# Balance and level belong to the sink that actually carries loudness. A DSP
# sink -- a speaker tuning, or EasyEffects -- can be the selected output while
# the volume lives on the physical sink underneath; this is the same resolution
# the volume keys and the panel's own slider already use. Only the pactl calls
# resolve: the *saved* key stays the output as the picker names it, so
# remembered settings keep matching the rows the panel draws.
volume_sink() {
  local resolved
  resolved="$(omarchy-audio-output-sink "$1" 2>/dev/null)" || resolved=""
  printf '%s\n' "${resolved:-$1}"
}

# One integer percentage per channel, in channel order. Empty if the sink is
# gone -- callers decide what that means rather than dying under pipefail.
channel_levels() {
  pactl get-sink-volume "$1" 2>/dev/null | awk '
    NR == 1 { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+%$/) {gsub(/%/, "", $i); print $i + 0} }' || true
}

channel_count() {
  channel_levels "$1" | grep -c . || true
}

set_levels() {
  local target="$1" level
  shift
  local -a args=()
  for level in "$@"; do args+=("${level}%"); done
  # Never fatal -- a sink can vanish between reading it and writing it, and the
  # caller still has work to do -- but never silent either: without this, a
  # rejected write is indistinguishable from the balance simply not working.
  if ! pactl set-sink-volume "$target" "${args[@]}"; then
    echo "little-stereo: could not set volume on $target (${args[*]})" >&2
  fi
}

# The master level is the loudest channel: balance only ever attenuates the
# quiet side, so the loud one still reads the level the user chose. Compare
# numerically -- awk's gsub() strips a field's numeric type, and the resulting
# string compare ranks "65" above "100".
current_level() {
  local levels
  levels="$(channel_levels "$(volume_sink "$1")")"
  # No channels at all means the sink could not be read -- one mid-connect, or
  # one that just went away. That is not the same as a level of zero, and
  # remembering it as zero would mute the output the next time balance applied.
  # Say nothing instead, and let callers skip rather than guess.
  [[ -n $levels ]] || return 0
  printf '%s\n' "$levels" | sort -n | tail -1
}

# (3) Background reads must not create state; only a deliberate user action
# does. A remembered level is only meaningful as the base a balance is rebuilt
# from, so an install that has never used one stays empty until it does.
remember_level() {
  [[ -f $balances || -f $balance_levels ]] || return 0
  save_level "$1" "$2"
}

apply_balance() {
  local sink="$1" target count balance base factor attenuated
  local perceived_left perceived_right logical_left logical_right

  # Nothing remembered means nothing to impose. This keeps `cleanup` from
  # recreating the files it just deleted, and keeps a fresh install from
  # writing per-channel volumes it was never asked for.
  [[ -f $balances || -f $balance_levels ]] || return 0

  target="$(volume_sink "$sink")"
  count="$(channel_count "$target")"
  (( count > 0 )) || return 0

  balance="$(saved_balance "$sink")"
  base="$(saved_level "$sink")"
  if [[ -z $base ]]; then
    base="$(current_level "$sink")"
    (( base > 0 )) || base=100
    save_level "$sink" "$base"
  fi

  # Balance only means something across a stereo pair, and pactl refuses a
  # channel count it did not ask for ("you tried to set volumes for 2 channels,
  # whereas channel(s) supported = 1"). Mono and surround outputs still get the
  # master level -- a single value applies it to every channel -- so the volume
  # slider keeps working where the balance cannot.
  if (( count != 2 )); then
    set_levels "$target" "$base"
    return 0
  fi

  factor=$(( 100 - (balance < 0 ? -balance : balance) ))
  attenuated="$(awk -v base="$base" -v factor="$factor" 'BEGIN {
    printf "%.2f", factor <= 0 ? 0 : base * exp(log(factor / 100) / 3)
  }')"

  if (( balance < 0 )); then
    perceived_left=$base
    perceived_right=$attenuated
  else
    perceived_left=$attenuated
    perceived_right=$base
  fi

  # The WirePlumber filter has already crossed the channels, so the sink's own
  # front-left now feeds the speaker on the listener's right. Cross the volumes
  # back, so "left" on the slider stays the side it is actually heard from.
  if is_saved "$sink"; then
    logical_left=$perceived_right
    logical_right=$perceived_left
  else
    logical_left=$perceived_left
    logical_right=$perceived_right
  fi

  set_levels "$target" "$logical_left" "$logical_right"
}

render_rules() {
  local temporary sink rule rules=""
  mkdir -p "$wireplumber_dir"
  temporary="$(mktemp "$wireplumber_dir/.90-channel-swap.XXXXXX")"

  if [[ -f $preferences ]]; then
    while IFS= read -r sink; do
      [[ -n $sink ]] || continue
      valid_sink "$sink" || continue
      rule="  { matches = [ { node.name = \"$sink\" } ] actions = { create-filter-graph = [ { nodes = [ { type = builtin name = left label = copy } { type = builtin name = right label = copy } ] inputs = [ \"left:In\" \"right:In\" ] outputs = [ \"right:Out\" \"left:Out\" ] } ] } }"
      rules+="$rule"$'\n'
    done < "$preferences"
  fi

  {
    printf '# Generated by the Omarchy Audio L/R setting.\n'
    [[ -n $rules ]] && printf 'node.filter-graph.rules = [\n%s]\n' "$rules"
  } > "$temporary"
  mv "$temporary" "$rule_file"
}

restore_sink() {
  local sink="$1"
  local address node_id
  if [[ $sink == bluez_output.* ]]; then
    address="${sink#bluez_output.}"
    address="${address%%.*}"
    address="${address//_/:}"
    bluetoothctl connect "$address" >/dev/null 2>&1 || true
  fi

  for _ in {1..30}; do
    node_id="$(pactl list short sinks 2>/dev/null | awk -v name="$sink" '$2 == name {print $1; exit}')"
    [[ -n $node_id ]] && break
    sleep 0.1
  done
  [[ -n ${node_id:-} ]] && omarchy-audio-output-set-default "$node_id" "$sink" || true
  [[ -n ${node_id:-} ]] && apply_balance "$sink" || true
}

# Defensive, not a proven fix. Restarting WirePlumber tears down and re-creates
# every node in the graph, and Quickshell has been seen to segfault in delegate
# incubation when the node list moves under it. The kill above is what protects
# the *running* shell from that; this protects the replacement, which would
# otherwise start building its device rows while the graph is still settling.
# Cheap enough (well under a second on a quiet graph) to be worth the doubt.
wait_for_stable_graph() {
  local previous="" current stable=0 deadline=$((SECONDS + 5))

  while (( SECONDS < deadline )); do
    current="$(pactl list short sinks 2>/dev/null; pactl list short sources 2>/dev/null)" || current=""
    if [[ -n $current && $current == "$previous" ]]; then
      stable=$(( stable + 1 ))
      if (( stable >= 3 )); then return 0; fi
    else
      stable=0
    fi
    previous="$current"
    sleep 0.2
  done

  return 0
}

reload_audio_safely() {
  local sink="$1"

  # Everything below runs with the bar already killed, and any step of it can
  # fail: wireplumber may refuse to restart, the sink may never come back. Under
  # `set -e` that would exit here and leave the user with no bar and no way back
  # short of a TTY. Restarting the shell on the way out -- however we leave --
  # is the one thing that must not be conditional.
  trap 'omarchy restart shell' EXIT

  local attempt
  for attempt in {1..20}; do
    timeout 5 quickshell kill -p "$omarchy_path/shell" --any-display >/dev/null 2>&1 || break
  done

  systemctl --user restart wireplumber.service
  restore_sink "$sink"
  wait_for_stable_graph
}

cleanup() {
  local sink
  sink="$(current_sink)"
  rm -f "$preferences" "$balances" "$balance_levels" "$names" "$rule_file"
  systemd-run --user --collect --quiet --property=Type=exec \
    "$script_path" reload "$sink"
}

case "${1:-status}" in
  list)
    [[ -f $preferences ]] && sed '/^[[:space:]]*$/d' "$preferences" || true
    ;;
  names-list)
    [[ -f $names ]] && sed '/^[[:space:]]*$/d' "$names" || true
    ;;
  name-status)
    saved_name "${2:-$(current_sink)}"
    ;;
  name-set)
    [[ $# -ge 2 ]] || exit 2
    sink="$2"
    valid_sink "$sink" || exit 2
    # The panel already trims and length-limits. This is only a backstop against
    # anything else calling the helper, so it rejects rather than truncates: a
    # byte-wise cut would slice a multi-byte character in half and write broken
    # UTF-8 into the file.
    label="$(printf '%s' "${3:-}" | tr -d '\t\n\r')"
    # Measured in bytes via wc, not ${#label}: that counts characters under a
    # UTF-8 locale and bytes under LC_ALL=C, and this runs in both.
    (( $(printf '%s' "$label" | wc -c) <= 200 )) || exit 2
    save_name "$sink" "$label"
    ;;
  balance-list)
    [[ -f $balances ]] && awk -F '\t' '$2 != 0 {print $1 "\t" $2}' "$balances" || true
    ;;
  status)
    sink="${2:-$(current_sink)}"
    is_saved "$sink" && echo active || echo inactive
    ;;
  balance-status)
    saved_balance "${2:-$(current_sink)}"
    ;;
  balance-level-status)
    sink="${2:-$(current_sink)}"
    value="$(current_level "$sink")"
    [[ -n $value ]] || exit 0
    remember_level "$sink" "$value"
    echo "$value"
    ;;
  restore)
    sink="${2:-$(current_sink)}"
    value="$(current_level "$sink")"
    [[ -n $value ]] || exit 0
    remember_level "$sink" "$value"
    apply_balance "$sink"
    echo "$value"
    ;;
  balance)
    sink="${3:-$(current_sink)}"
    value="${2:-0}"
    [[ $value =~ ^-?[0-9]+$ ]] && (( value >= -100 && value <= 100 )) || exit 2
    save_balance "$sink" "$value"
    apply_balance "$sink"
    ;;
  balance-level)
    sink="${3:-$(current_sink)}"
    value="${2:-100}"
    [[ $value =~ ^[0-9]+$ ]] && (( value >= 0 && value <= 150 )) || exit 2
    save_level "$sink" "$value"
    apply_balance "$sink"
    ;;
  select)
    [[ $# == 3 ]] || exit 2
    omarchy-audio-output-set-default "$2" "$3"
    apply_balance "$3"
    ;;
  toggle)
    sink="${2:-$(current_sink)}"
    valid_sink "$sink" || { echo "Unsupported output name: $sink" >&2; exit 1; }
    if is_saved "$sink"; then save_preference "$sink" false; else save_preference "$sink" true; fi
    render_rules
    systemd-run --user --collect --quiet --property=Type=exec \
      "$script_path" reload "$sink"
    ;;
  apply)
    render_rules
    ;;
  reload)
    [[ $# == 2 ]] || exit 2
    reload_audio_safely "$2"
    ;;
  cleanup)
    cleanup
    ;;
  *)
    echo "Usage: ${0##*/} [list|status|toggle|apply|reload|restore|cleanup|balance-status|balance|balance-level|select|names-list|name-status|name-set]" >&2
    exit 2
    ;;
esac
